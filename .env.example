# =========================================================================
# reglo — variables d'environnement (EXEMPLE)
# Copie ce fichier en `.env.local` et remplis les valeurs.
# NE COMMITTE JAMAIS `.env.local`. Aucune clé ne doit finir dans le dépôt.
# =========================================================================

# --- Base de données Neon (Postgres) --------------------------------------
# Depuis Neon > Project > Connect. Utilise la chaîne "pooled" pour l'app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Chaîne "unpooled" (direct) — utilisée par les migrations Drizzle.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- URL publique de l'app ------------------------------------------------
# En local : http://localhost:3000 — en prod : https://ton-domaine.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (Phase 3) — Better Auth / Neon Managed Better Auth --------------
# Secret de signature de session. Génère-le : openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Seuls ces e-mails peuvent se connecter (2 max). Séparés par des virgules.
AUTH_ALLOWED_EMAILS="coleen@exemple.fr,raph@exemple.fr"

# Relying Party WebAuthn (passkey). rpID = domaine SANS protocole ni port.
# En prod : ton-domaine.vercel.app — en local : localhost
NEXT_PUBLIC_PASSKEY_RP_ID="localhost"
NEXT_PUBLIC_PASSKEY_RP_NAME="reglo"

# --- E-mail (Phase 3) — Resend pour livrer les codes OTP ------------------
RESEND_API_KEY=""
# Adresse d'expéditeur vérifiée dans Resend.
OTP_FROM_EMAIL="reglo <no-reply@ton-domaine>"
